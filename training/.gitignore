# Virtualenv / uv
.venv/
uv.lock

# Secrets
.env

# Generated datasets and artifacts (large, reproducible) -- per model
models/*/data/raw/
models/*/data/merged/
models/*/data/negatives_pool/
models/*/data/mining/
models/*/data/custom/previews/
models/*/data/golden/data.yaml
models/*/runs/
models/*/exports/

# Downloaded base weights (auto-fetched by ultralytics)
*.pt

# Reviewed custom frames and YOLO labels are source training data and tracked.
# Keep raw source videos and other drop-in/generated data out of Git.
models/*/data/custom/videos/*
models/*/data/negatives/*
models/*/data/golden/images/*
models/*/data/golden/labels/*
!**/.gitkeep

# Python caches
__pycache__/
*.pyc
