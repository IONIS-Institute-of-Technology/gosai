{
  "name": "@gosai/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Official TypeScript SDK for building GOSAI apps",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./src/host.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/host.ts --splitting --target=browser --format=esm --outdir dist",
    "dev": "bun run build --watch",
    "typecheck": "tsc && tsc -p test",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "@gosai/shared": "workspace:*"
  }
}
