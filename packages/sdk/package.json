{
  "name": "@gosai/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Official TypeScript SDK for building GOSAI apps",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b && bun run build:browser",
    "build:browser": "bun build src/index.ts --target=browser --format=esm --outfile dist/browser.js",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@gosai/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
