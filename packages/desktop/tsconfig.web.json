{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out/renderer",
    "tsBuildInfoFile": "./desktop-web.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/renderer/**/*.d.ts"
  ],
  "exclude": ["node_modules", "out", "dist"],
  "references": [{ "path": "../shared" }]
}
