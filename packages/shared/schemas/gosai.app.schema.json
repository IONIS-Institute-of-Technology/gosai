{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique app id. Names its directory and driver binding."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name."
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "description": "Shown by the dashboard.",
      "type": "string"
    },
    "icon": {
      "description": "Image shown by the dashboard, relative to the app root.",
      "type": "string",
      "minLength": 1
    },
    "experiences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "description": "ES module, relative to the app root, that default-exports the experience."
          },
          "python": {
            "description": "Reserved for app-provided Python drivers.",
            "type": "string"
          },
          "drivers": {
            "default": [],
            "description": "Drivers kept running while the experience runs.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "exclusive": {
            "default": false,
            "description": "Starting this experience stops the app's other experiences, except `allowed`.",
            "type": "boolean"
          },
          "allowed": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "required": {
            "description": "Experiences that start first, with the same driver binding.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "required": ["slug", "name", "entry"],
        "additionalProperties": false
      }
    },
    "default": {
      "description": "Experience the dashboard's primary button starts. Defaults to the first.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "python": {
      "description": "Reserved for app-provided Python drivers.",
      "type": "object",
      "properties": {
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "startup": {
      "description": "Experiences started at server boot when the app is in the global autoStartApps. Defaults to the default experience.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "capabilities": {
      "description": "Capabilities the app needs beyond the defaults. Shown at install.",
      "type": "array",
      "items": {
        "enum": [
          "apps:read",
          "experiences:read",
          "experiences:control",
          "drivers:read",
          "drivers:use",
          "devices:read",
          "config:read",
          "app-config:read",
          "app-config:write",
          "storage:read",
          "storage:write",
          "app-events:use",
          "logs:read",
          "logs:write",
          "system:read"
        ],
        "type": "string"
      }
    },
    "network": {
      "description": "External origins the app connects to. Shown at install and added to the page's CSP.",
      "type": "object",
      "properties": {
        "connect": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "description": "Device kinds the app uses, for the per-app device pickers.",
      "type": "object",
      "properties": {
        "display": {
          "type": "boolean"
        },
        "camera": {
          "type": "boolean"
        },
        "microphone": {
          "type": "boolean"
        },
        "speaker": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "statusKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        }
      },
      "required": ["required"],
      "additionalProperties": false
    },
    "settings": {
      "description": "Settings the dashboard edits, stored as one object in app storage.",
      "type": "object",
      "properties": {
        "storageKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "const": "boolean"
                        },
                        "default": {
                          "type": "boolean"
                        }
                      },
                      "required": ["key", "label", "type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "const": "string"
                        },
                        "default": {
                          "type": "string"
                        }
                      },
                      "required": ["key", "label", "type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "const": "number"
                        },
                        "default": {
                          "type": "number"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "step": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": ["key", "label", "type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "const": "select"
                        },
                        "default": {
                          "type": "string"
                        },
                        "options": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              }
                            },
                            "required": ["value", "label"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["key", "label", "type", "options"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["label", "fields"],
            "additionalProperties": false
          }
        }
      },
      "required": ["groups"],
      "additionalProperties": false
    }
  },
  "required": ["slug", "name", "version", "experiences"],
  "additionalProperties": false,
  "title": "GOSAI app manifest (gosai.app.json)"
}
