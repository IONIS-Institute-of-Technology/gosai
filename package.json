{
  "name": "gosai",
  "version": "0.1.0",
  "private": true,
  "description": "GOSAI - General-purpose Operating System for Augmented Interfaces",
  "license": "GPL-3.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun run --elide-lines=0 --filter @gosai/server dev",
    "dev:desktop": "bun run --elide-lines=0 --filter @gosai/desktop dev",
    "build": "bun run --filter '@gosai/*' build",
    "build:sdk": "bun run --filter @gosai/sdk build",
    "build:desktop": "bun run --filter @gosai/desktop build",
    "build:apps": "bun run --filter './apps/*' build",
    "build:server-bin": "mkdir -p packages/desktop/release/server && bun build packages/server/src/index.ts --compile --outfile packages/desktop/release/server/gosai-server",
    "package:mac": "bun run build && bun run build:apps && bun run build:server-bin && bun --filter @gosai/desktop run dist:mac",
    "package:linux": "bun run build && bun run build:apps && bun run build:server-bin && bun --filter @gosai/desktop run dist:linux",
    "package:kiosk": "bun scripts/package-kiosk.ts",
    "kiosk": "bun packages/cli/src/index.ts kiosk",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' --filter './templates/*' typecheck && tsc -p scripts",
    "test": "bun run --filter '@gosai/*' test",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "bun run --filter './packages/*' clean && rm -rf node_modules",
    "python:sync": "cd python && uv sync",
    "python:lint": "cd python && uv run ruff check .",
    "python:test": "cd python && uv run pytest -q",
    "python:check": "cd python && uv run ruff check . && uv run pyright && uv run pytest -q",
    "training:lint": "cd training && uv run --only-group dev ruff check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
